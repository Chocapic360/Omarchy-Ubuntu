#!/bin/bash
# omu-power-key-inhibit: stop logind powering off on the power key for as long as this Hyprland runs.
# Hyprland's XF86PowerOff binding (omu-power-button) then handles the key instead.
pid=$(hyprctl instances -j 2>/dev/null |
  jq -r --arg sig "$HYPRLAND_INSTANCE_SIGNATURE" '.[] | select(.instance == $sig) | .pid')
[[ -n $pid ]] || pid=$(pgrep -o -x Hyprland)
[[ -n $pid ]] || exit 1
exec systemd-inhibit --what=handle-power-key --mode=block --who="Omarchy Ubuntu" \
  --why="Power key opens the power menu" tail --pid="$pid" -f /dev/null
