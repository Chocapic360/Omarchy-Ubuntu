#!/bin/bash
# omu-brightness: up|down [step]. Shows the SwayOSD popup when it's running.
step="${2:-5}"
osd() { pgrep -x swayosd-server >/dev/null && command -v swayosd-client >/dev/null; }

case "$1" in
up)
  if osd; then swayosd-client --brightness "+$step"; else brightnessctl -q set "${step}%+"; fi ;;
down)
  if osd; then swayosd-client --brightness "-$step"; else brightnessctl -q -n1 set "${step}%-"; fi ;;
*)
  echo "Usage: omu-brightness up|down [step]" >&2; exit 2 ;;
esac
