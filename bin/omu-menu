#!/bin/bash
# omu-menu: Omarchy-style control menu (Super + Space).
# Adapted from Omarchy 3.8's omarchy-menu (MIT, David Heinemeier Hansson).
# Usage: omu-menu [apps|learn|capture|toggle|style|background|setup|power|update|system]

REPO="$(dirname "$(readlink -f "$(command -v omu-menu)")")/.."
REPO="$(readlink -f "$REPO")"

# Set when jumping straight to a submenu, so Esc exits instead of going back
BACK_TO_EXIT=false

back_to() {
  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $1 ]]; then
    "$1"
  else
    show_main_menu
  fi
}

menu() {
  echo -e "$2" | omu-dmenu -p "$1…" -w "${3:-26}"
}

present_terminal() {
  omu-launch-terminal --float -e bash -c "$1; echo; read -n 1 -s -r -p 'Done. Press any key to close.'"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  omu-launch-editor "$1"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Omarchy\n  Hyprland\n  Ubuntu\n󰹎  This setup") in
  *Keybindings*) omu-menu-keybindings ;;
  *Omarchy*) xdg-open "https://learn.omacom.io/2/the-omarchy-manual" ;;
  *Hyprland*) xdg-open "https://wiki.hypr.land/" ;;
  *Ubuntu*) xdg-open "https://help.ubuntu.com/" ;;
  *setup*) xdg-open "https://github.com/Chocapic360/omarchy-ubuntu" ;;
  *) back_to show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenshot (full screen)\n󰃉  Color") in
  *full*) omu-screenshot output ;;
  *Screenshot*) omu-screenshot region ;;
  *Color*) omu-color-picker ;;
  *) back_to show_main_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󰍜  Top Bar\n󱫖  Idle Lock\n󰔎  Nightlight\n󰂛  Notifications\n  Window Gaps") in
  *Bar*) omu-toggle-waybar ;;
  *Idle*) omu-toggle-idle ;;
  *Nightlight*) omu-toggle-nightlight ;;
  *Notifications*) omu-toggle-notification-silencing ;;
  *Gaps*) omu-toggle-gaps ;;
  *) back_to show_main_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "  Background\n󰸌  Theme colors\n  Hyprland look") in
  *Background*) show_background_menu ;;
  *Theme*) open_in_editor "$HOME/.config/omarchy-ubuntu/current/theme" ;;
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.conf ;;
  *) back_to show_main_menu ;;
  esac
}

show_background_menu() {
  local dir="$HOME/.config/omarchy-ubuntu/current/theme/backgrounds"
  local choice
  choice=$(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -printf '%f\n' 2>/dev/null | sort | omu-dmenu -p "Background…" -w 40)
  if [[ -n $choice ]]; then
    omu-bg-set "$dir/$choice"
  else
    back_to show_style_menu
  fi
}

show_setup_menu() {
  case $(menu "Setup" "  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n  Defaults\n󰍹  Monitors\n  Keybindings\n  Input\n  Config") in
  *Audio*) pavucontrol ;;
  *Wifi*) omu-menu-network ;;
  *Bluetooth*) omu-menu-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *Defaults*) show_setup_default_menu ;;
  *Monitors*) open_in_editor ~/.config/hypr/monitors.conf ;;
  *Keybindings*) open_in_editor ~/.config/hypr/bindings/apps.conf ;;
  *Input*) open_in_editor ~/.config/hypr/input.conf ;;
  *Config*) show_setup_config_menu ;;
  *) back_to show_main_menu ;;
  esac
}

show_setup_power_menu() {
  local current
  current=$(powerprofilesctl get 2>/dev/null)
  case $(menu "Power Profile ($current)" "󰾆  power-saver\n󰾅  balanced\n󰓅  performance" 30) in
  *power-saver*) powerprofilesctl set power-saver ;;
  *balanced*) powerprofilesctl set balanced ;;
  *performance*) powerprofilesctl set performance ;;
  *) back_to show_setup_menu ;;
  esac
}

# ---- Default apps -------------------------------------------------------


show_setup_default_menu() {
  case $(menu "Defaults" "  Browser\n  Terminal\n  Editor\n  File manager") in
  *Browser*) show_setup_default_browser_menu ;;
  *Terminal*) show_setup_default_terminal_menu ;;
  *Editor*) show_setup_default_editor_menu ;;
  *File*) show_setup_default_files_menu ;;
  *) back_to show_setup_menu ;;
  esac
}

# Pick one of "Label<TAB>value" lines; prints the value
pick_default() {
  local prompt="$1" current="$2" list="$3" choice
  choice=$(printf '%s\n' "$list" | awk -F'\t' -v cur="$current" 'NF { print $1 ($2 == cur ? "  (current)" : "") }' |
    omu-dmenu -p "$prompt…" -w 34)
  [[ -z $choice ]] && return 1
  choice="${choice%  (current)}"
  printf '%s\n' "$list" | awk -F'\t' -v want="$choice" '$1 == want { print $2; exit }'
}

# Keep entries whose command (after the tab) is installed
installed_only() {
  local label cmd
  while IFS=$'\t' read -r label cmd; do
    command -v "${cmd%% *}" >/dev/null && printf '%s\t%s\n' "$label" "$cmd"
  done
}

show_setup_default_browser_menu() {
  local list current id
  list=$(omu-desktop-file browsers)
  if [[ -z $list ]]; then
    notify-send -u normal "No browsers found" "Install one first, e.g. sudo apt install firefox"
    back_to show_setup_default_menu
    return
  fi
  current=$(xdg-settings get default-web-browser 2>/dev/null)
  id=$(pick_default "Default Browser" "$current" "$list") || { back_to show_setup_default_menu; return; }
  xdg-settings set default-web-browser "$id"
  for mime in x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml; do
    xdg-mime default "$id" "$mime"
  done
  notify-send -u low "    Default browser" "$(printf '%s\n' "$list" | awk -F'\t' -v id="$id" '$2 == id { print $1 }')"
}

show_setup_default_terminal_menu() {
  local list current term
  list=$(printf '%s\t%s\n' \
    "Alacritty" alacritty "Ghostty" ghostty "Kitty" kitty "Foot" foot \
    "WezTerm" wezterm "Ptyxis" ptyxis "GNOME Terminal" gnome-terminal | installed_only)
  current=$(omu-defaults get terminal alacritty)
  term=$(pick_default "Default Terminal" "$current" "$list") || { back_to show_setup_default_menu; return; }
  omu-defaults set terminal "$term"
  notify-send -u low "    Default terminal" "$term (Super + Return)"
}

show_setup_default_editor_menu() {
  local list current editor desktop
  list=$(printf '%s\t%s\n' \
    "Zed" zeditor "Zed" zed "VS Code" code "Cursor" cursor "Sublime Text" subl \
    "Text Editor" gnome-text-editor "Neovim" nvim "Vim" vim "Helix" hx "Micro" micro "Nano" nano |
    installed_only | awk -F'\t' '!seen[$1]++')
  current=$(omu-defaults get editor "")
  editor=$(pick_default "Default Editor" "$current" "$list") || { back_to show_setup_default_menu; return; }
  omu-defaults set editor "$editor"

  # GUI editors also become the default for plain text files
  case "$editor" in
  zeditor | zed) desktop=dev.zed.Zed.desktop ;;
  code) desktop=code.desktop ;;
  cursor) desktop=cursor.desktop ;;
  subl) desktop=sublime_text.desktop ;;
  gnome-text-editor) desktop=org.gnome.TextEditor.desktop ;;
  esac
  [[ -n $desktop ]] && omu-desktop-file path "$desktop" >/dev/null && xdg-mime default "$desktop" text/plain

  notify-send -u low "    Default editor" "$editor (Super + Shift + N)"
}

show_setup_default_files_menu() {
  local list current fm desktop
  list=$(printf '%s\t%s\n' \
    "Files (Nautilus)" nautilus "Nemo" nemo "Thunar" thunar "Dolphin" dolphin \
    "Yazi" yazi "Ranger" ranger | installed_only)
  current=$(omu-defaults get files nautilus)
  fm=$(pick_default "Default File Manager" "$current" "$list") || { back_to show_setup_default_menu; return; }
  omu-defaults set files "$fm"

  case "$fm" in
  nautilus) desktop=org.gnome.Nautilus.desktop ;;
  nemo) desktop=nemo.desktop ;;
  thunar) desktop=thunar.desktop ;;
  dolphin) desktop=org.kde.dolphin.desktop ;;
  esac
  [[ -n $desktop ]] && omu-desktop-file path "$desktop" >/dev/null && xdg-mime default "$desktop" inode/directory

  notify-send -u low "    Default file manager" "$fm (Super + Shift + F)"
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Hypridle\n  Hyprlock\n  Swayosd\n󰌧  Fuzzel\n󰍜  Waybar\n󰎟  Mako\n  Alacritty") in
  *Hyprland*) open_in_editor ~/.config/hypr/hyprland.conf ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml ;;
  *Fuzzel*) open_in_editor ~/.config/fuzzel/fuzzel.ini ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc ;;
  *Mako*) open_in_editor ~/.config/mako/config ;;
  *Alacritty*) open_in_editor ~/.config/alacritty/alacritty.toml ;;
  *) back_to show_setup_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "  System packages\n  This setup (git pull)\n󰍜  Restart Waybar\n  Reload Hyprland") in
  *System*) present_terminal "sudo apt update && sudo apt full-upgrade" ;;
  *setup*) present_terminal "git -C '$REPO' pull --ff-only && '$REPO/install.sh' --links-only" ;;
  *Waybar*) omu-restart-waybar ;;
  *Hyprland*) hyprctl reload && notify-send -u low "Hyprland reloaded" "$(hyprctl configerrors | head -5)" ;;
  *) back_to show_main_menu ;;
  esac
}

show_system_menu() {
  case $(menu "System" "  Lock\n󰒲  Suspend\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown") in
  *Lock*) omu-lock ;;
  *Suspend*) systemctl suspend ;;
  *Logout*) hyprctl dispatch exit ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n  Capture\n󰔎  Toggle\n  Style\n  Setup\n  Update\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) omu-launcher ;;
  *learn*) show_learn_menu ;;
  *capture*) show_capture_menu ;;
  *toggle*) show_toggle_menu ;;
  *background*) show_background_menu ;;
  *style*) show_style_menu ;;
  *power*) show_setup_power_menu ;;
  *setup*) show_setup_menu ;;
  *update*) show_update_menu ;;
  *system*) show_system_menu ;;
  esac
}

# Pressing the shortcut again while a menu is open closes it
if pgrep -x fuzzel >/dev/null; then
  pkill -x fuzzel
  exit 0
fi

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
