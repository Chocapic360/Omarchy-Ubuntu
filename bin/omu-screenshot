#!/bin/bash
# omu-screenshot: save to ~/Pictures/Screenshots and copy to the clipboard.
# Usage: omu-screenshot [region|output]   (click the notification to annotate with satty, if installed)
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

pkill -x slurp && exit 0

case "${1:-region}" in
output)
  geometry=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | "\(.x),\(.y) \((.width / .scale) | floor)x\((.height / .scale) | floor)"')
  ;;
*)
  geometry=$(slurp 2>/dev/null) || exit 0
  ;;
esac

grim -g "$geometry" "$file" || exit 1
wl-copy <"$file"

(
  if command -v satty >/dev/null; then
    action=$(notify-send "Screenshot saved to clipboard and file" "Click to edit" -t 10000 -i "$file" -A "default=edit")
    [[ $action == "default" ]] && satty --filename "$file" --output-filename "$file" --copy-command wl-copy
  else
    notify-send "Screenshot saved to clipboard and file" "$file" -t 5000 -i "$file"
  fi
) >/dev/null 2>&1 &
