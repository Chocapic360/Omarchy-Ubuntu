#!/bin/bash
# omu-launch-browser: open the default browser (Setup > Defaults > Browser).
# Pass --private for a private/incognito window.
desktop=$(xdg-settings get default-web-browser 2>/dev/null)
file=$(omu-desktop-file path "$desktop")
exec_line=$(grep -m1 '^Exec=' "$file" 2>/dev/null | sed -E 's/^Exec=//; s/ %[uUfF]//g; s/ @@[uU]? *@@//g')

if [[ -z $exec_line ]]; then
  exec xdg-open "https://"
fi

if [[ $1 == "--private" ]]; then
  case "$exec_line" in
  *firefox* | *librewolf* | *zen*) exec $exec_line --private-window ;;
  *) exec $exec_line --incognito ;;
  esac
fi

exec $exec_line "$@"
