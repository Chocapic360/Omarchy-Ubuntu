#!/bin/bash
# omu-session: login entry for the "Hyprland (Omarchy Ubuntu)" session in GDM.
# Puts ~/.local/bin on PATH so Hyprland can find the omu-* scripts, starts Hyprland,
# and when Hyprland exits, removes the variables it shared with systemd so a
# following GNOME login starts clean.
export PATH="$HOME/.local/bin:$PATH"

# Snap and Flatpak apps: make sure their .desktop folders are on XDG_DATA_DIRS (and
# /snap/bin on PATH) so the launcher lists them. Both scripts skip what's already there.
for f in /etc/profile.d/apps-bin-path.sh /etc/profile.d/flatpak.sh; do
  [ -r "$f" ] && . "$f"
done

if command -v start-hyprland >/dev/null; then
  start-hyprland
else
  Hyprland
fi
status=$?

SHARED_VARS=(WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP
  HYPRLAND_INSTANCE_SIGNATURE GTK_THEME ADW_DEBUG_COLOR_SCHEME QT_QPA_PLATFORM
  ELECTRON_OZONE_PLATFORM_HINT MOZ_ENABLE_WAYLAND)
systemctl --user unset-environment "${SHARED_VARS[@]}" 2>/dev/null
dbus-update-activation-environment --systemd ADW_DEBUG_COLOR_SCHEME= 2>/dev/null

exit $status
